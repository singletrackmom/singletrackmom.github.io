<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>AI Opportunity Pipeline · Student Support and Success</title>
<style>
:root{
  --surface:#fcfcfb; --plane:#f9f9f7; --panel:#ffffff;
  --ink:#0b0b0b; --ink2:#52514e; --muted:#898781;
  --grid:#e1e0d9; --axis:#c3c2b7; --line:#e6e4dd;
  --brand:#7a5080; --brand-ink:#5d3d62;
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100; --s5:#e87ba4; --s6:#4a3aa7;
  --good:#0ca30c; --warn:#fab219; --serious:#ec835a; --crit:#d03b3b;
  --shadow:0 1px 2px rgba(11,11,11,.06),0 4px 12px rgba(11,11,11,.04);
}
:root[data-theme="dark"]{
  --surface:#1a1a19; --plane:#0d0d0d; --panel:#232322;
  --ink:#ffffff; --ink2:#c3c2b7; --muted:#898781;
  --grid:#2c2c2a; --axis:#383835; --line:#2c2c2a;
  --brand:#b98cc0; --brand-ink:#cba9d0;
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181; --s6:#9085e9;
  --shadow:none;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --surface:#1a1a19; --plane:#0d0d0d; --panel:#232322;
    --ink:#ffffff; --ink2:#c3c2b7; --muted:#898781;
    --grid:#2c2c2a; --axis:#383835; --line:#2c2c2a;
    --brand:#b98cc0; --brand-ink:#cba9d0;
    --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181; --s6:#9085e9;
    --shadow:none;
  }
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--plane);color:var(--ink);
  font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased}
.wrap{max-width:1240px;margin:0 auto;padding:0 20px 64px}

/* header */
header{background:var(--brand);color:#fff;padding:22px 0 18px}
:root[data-theme="dark"] header{background:#3a2540}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) header{background:#3a2540}}
.hin{max-width:1240px;margin:0 auto;padding:0 20px}
.eyebrow{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;opacity:.82;font-weight:600}
h1{font-size:1.5rem;font-weight:600;letter-spacing:-.01em;margin:.3rem 0 .15rem}
.sub{font-size:.9rem;opacity:.85;margin-bottom:16px}
nav{display:flex;gap:2px;flex-wrap:wrap}
nav button{background:rgba(255,255,255,.12);color:#fff;border:0;border-radius:6px 6px 0 0;
  padding:9px 15px;font:inherit;font-size:.85rem;font-weight:500;cursor:pointer}
nav button:hover{background:rgba(255,255,255,.2)}
nav button[aria-selected="true"]{background:var(--plane);color:var(--brand-ink);font-weight:600}
.themebtn{position:absolute;top:20px;right:24px;background:rgba(255,255,255,.14);color:#fff;
  border:0;border-radius:6px;padding:6px 11px;font-size:.78rem;cursor:pointer}

/* banner */
.demo{background:#fff8e6;border:1px solid #f0d99a;color:#6b4e0a;border-radius:8px;
  padding:11px 14px;font-size:.83rem;margin:18px 0 20px}
:root[data-theme="dark"] .demo{background:#3a3212;border-color:#6b5a1e;color:#f5e2ab}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .demo{background:#3a3212;border-color:#6b5a1e;color:#f5e2ab}}
.demo b{font-weight:700}

/* sections */
h2{font-size:1.02rem;font-weight:650;margin:30px 0 3px;letter-spacing:-.005em}
h2:first-of-type{margin-top:6px}
.lede{font-size:.86rem;color:var(--ink2);margin-bottom:14px;max-width:74ch}

/* stat tiles */
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:12px;margin-bottom:8px}
.tile{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px 15px;box-shadow:var(--shadow)}
.tile .lab{font-size:.7rem;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);font-weight:650}
.tile .val{font-size:1.85rem;font-weight:680;letter-spacing:-.02em;line-height:1.12;margin-top:5px}
.tile .note{font-size:.76rem;color:var(--ink2);margin-top:3px}
.tile.flag{border-color:var(--crit)}
.tile.flag .val{color:var(--crit)}

/* cards + charts */
.grid{display:grid;gap:14px}
.g2{grid-template-columns:repeat(auto-fit,minmax(420px,1fr))}
.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px 17px 14px;box-shadow:var(--shadow);min-width:0}
.card h3{font-size:.92rem;font-weight:650;margin-bottom:2px}
.card .cs{font-size:.79rem;color:var(--ink2);margin-bottom:13px}
.legend{display:flex;flex-wrap:wrap;gap:11px;margin-bottom:11px}
.legend span{display:flex;align-items:center;gap:5px;font-size:.76rem;color:var(--ink2)}
.sw{width:11px;height:11px;border-radius:3px;flex:none}

/* horizontal bars */
.hb{display:flex;flex-direction:column;gap:9px}
.hbr{display:grid;grid-template-columns:132px 1fr auto;align-items:center;gap:10px}
.hbr .nm{font-size:.8rem;color:var(--ink2);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.trk{background:var(--grid);border-radius:4px;height:15px;position:relative;overflow:hidden}
.fil{height:100%;border-radius:0 4px 4px 0;position:relative}
.hbr .vv{font-size:.8rem;font-weight:650;font-variant-numeric:tabular-nums;min-width:26px;text-align:right}

/* stacked */
.stk{display:flex;height:26px;border-radius:5px;overflow:hidden;gap:2px;margin-bottom:9px}
.stk div{position:relative}

/* coverage dots */
.cov{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:8px}
.covi{display:flex;align-items:center;gap:7px;font-size:.79rem;padding:6px 8px;border-radius:6px;background:var(--plane)}
.dot{width:9px;height:9px;border-radius:50%;flex:none}

/* tables */
table{width:100%;border-collapse:collapse;font-size:.82rem}
.tw{overflow-x:auto}
th{text-align:left;font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);
  font-weight:650;padding:0 10px 7px 0;border-bottom:1px solid var(--axis);white-space:nowrap}
td{padding:9px 10px 9px 0;border-bottom:1px solid var(--line);vertical-align:top}
tbody tr:hover{background:var(--plane)}
.pill{display:inline-block;padding:2px 8px;border-radius:20px;font-size:.71rem;font-weight:650;white-space:nowrap}
.mono{font-variant-numeric:tabular-nums}
.vf{font-size:.68rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
.vf.yes{color:var(--good)} .vf.no{color:var(--muted)}

/* empty state */
.empty{background:var(--panel);border:1px dashed var(--axis);border-radius:10px;padding:30px 22px;text-align:center}
.empty h4{font-size:.95rem;font-weight:650;margin-bottom:5px}
.empty p{font-size:.84rem;color:var(--ink2);max-width:56ch;margin:0 auto}

/* form */
.form{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:20px;box-shadow:var(--shadow);max-width:760px}
fieldset{border:0;margin-bottom:22px}
legend{font-size:.7rem;letter-spacing:.07em;text-transform:uppercase;color:var(--brand-ink);font-weight:700;margin-bottom:9px}
label{display:block;font-size:.85rem;font-weight:600;margin:13px 0 4px}
.hint{font-size:.78rem;color:var(--ink2);font-weight:400;margin-bottom:5px}
input[type=text],select,textarea{width:100%;padding:8px 10px;border:1px solid var(--axis);border-radius:6px;
  background:var(--surface);color:var(--ink);font:inherit;font-size:.87rem}
textarea{min-height:66px;resize:vertical}
.checks{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:5px;margin-top:5px}
.checks label{display:flex;gap:7px;align-items:flex-start;font-weight:400;font-size:.83rem;margin:0;
  padding:6px 8px;border-radius:6px;background:var(--plane);cursor:pointer}
.checks input{margin-top:2px;flex:none}
.btn{background:var(--brand);color:#fff;border:0;border-radius:7px;padding:10px 20px;
  font:inherit;font-weight:600;font-size:.87rem;cursor:pointer}
.btn.ghost{background:transparent;color:var(--brand-ink);border:1px solid var(--axis)}
.toolbar{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.toolbar select{width:auto;min-width:140px}

input[type=email],input[type=number]{width:100%;padding:8px 10px;border:1px solid var(--axis);border-radius:6px;
  background:var(--surface);color:var(--ink);font:inherit;font-size:.87rem}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0 14px}
.grp{font-size:.85rem;font-weight:600;margin:13px 0 4px}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
#fmsg{margin-left:12px;font-size:.84rem;font-weight:600}
#fmsg.ok{color:var(--good)} #fmsg.bad{color:var(--crit)}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.tip{position:fixed;z-index:60;background:var(--ink);color:var(--surface);padding:6px 9px;border-radius:6px;
  font-size:.77rem;pointer-events:none;opacity:0;transition:opacity .1s;white-space:nowrap;box-shadow:0 4px 14px rgba(0,0,0,.24)}
.tip.on{opacity:1}
.hidden{display:none!important}
footer{margin-top:44px;padding-top:16px;border-top:1px solid var(--line);font-size:.78rem;color:var(--muted)}
@media(max-width:640px){.hbr{grid-template-columns:96px 1fr auto}.g2{grid-template-columns:1fr}}
</style>
</head>
<body>
<p style="margin:0;padding:.7rem 1.25rem 0"><a href="/pipeline/overview.html" style="font:600 .8rem/1.2 'DM Sans',system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#7a5080;text-decoration:none">&larr; Back to overview</a></p>
<div class="tip" id="tip"></div>

<header>
  <button class="themebtn" id="themebtn">Dark</button>
  <div class="hin">
    <div class="eyebrow">Maricopa AI Resource Center &middot; Student Support and Success, Domain 5</div>
    <h1>AI Opportunity Pipeline</h1>
    <div class="sub">Describe an opportunity. The domain reviews it, scores it, and answers with a reason.</div>
  </div>
</header>

<div class="wrap">
  <div class="demo">
    <b>Where requests go.</b> Each request is added to the domain&rsquo;s shared review sheet. Please do not enter student names or ID numbers.
  </div>

  <!-- ══════════ FORM ══════════ -->
  <section id="v-form">
    <form class="form" id="intake" novalidate>
      <fieldset>
        <legend>About you</legend>
        <label>Your name<input type="text" name="name" required autocomplete="name"></label>
        <label>Your email
          <div class="hint">So we can reply and set up a conversation.</div>
          <input type="email" name="email" required autocomplete="email"></label>
        <label>Your college
          <select name="college" required><option value="">Choose</option></select></label>
        <label>Your department or service
          <div class="hint">Use whatever you call it on your campus.</div>
          <input type="text" name="dept" required></label>
      </fieldset>

      <fieldset>
        <legend>The opportunity</legend>
        <label>What are you trying to get done
          <div class="hint">The goal, in plain words. For example: every student gets an answer from advising within one business day.</div>
          <textarea name="goal" required></textarea></label>
        <label>What is getting in the way
          <div class="hint">What takes too long, gets missed, or frustrates students or staff. For example: advising takes about three days to answer an email, or students never find disability resources because they do not think of themselves as disabled.</div>
          <textarea name="problem" required></textarea></label>
        <label>How is it done today
          <div class="hint">Walk through the steps. This is how an AI opportunity is told apart from a process fix.</div>
          <textarea name="current"></textarea></label>
        <label>What is driving this now
          <div class="hint">A deadline, a complaint, a new requirement, a budget cycle, or no date at all.</div>
          <input type="text" name="driver"></label>
      </fieldset>

      <fieldset>
        <legend>Who it touches</legend>
        <div class="grp">Who is served (choose all that apply)</div>
        <div class="checks">
          <label><input type="checkbox" name="audience" value="Students"> Students</label>
          <label><input type="checkbox" name="audience" value="Staff"> Staff</label>
          <label><input type="checkbox" name="audience" value="Faculty"> Faculty</label>
          <label><input type="checkbox" name="audience" value="Community members"> Community members</label>
          <label><input type="checkbox" name="audience" value="Other"> Other</label>
        </div>
        <label>About how many people does this touch
          <div class="hint">A number, and an estimate is fine. For example, 3000 students in a term.</div>
          <input type="number" name="reach" min="0" step="1" inputmode="numeric" required></label>
        <div class="two">
          <label>Times it happens in a week<input type="number" name="perweek" min="0" step="any" inputmode="decimal"></label>
          <label>Minutes each time<input type="number" name="minutes" min="0" step="any" inputmode="decimal"></label>
        </div>
        <label>Who does the work today<input type="text" name="doers"></label>
        <label>Who is affected by it<input type="text" name="affected"></label>
        <label>Who has to approve a change
          <div class="hint">A name and role.</div>
          <input type="text" name="approver" required></label>
        <div class="grp">Does your leadership know you are asking</div>
        <div class="checks">
          <label><input type="radio" name="aware" value="Yes"> Yes</label>
          <label><input type="radio" name="aware" value="No"> No</label>
          <label><input type="radio" name="aware" value="Not sure" checked> Not sure</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>What success looks like</legend>
        <label>What would show it worked
          <div class="hint">For example: advising answers every email within one business day.</div>
          <textarea name="measure" required></textarea></label>
        <div class="two">
          <label>Where it stands today<input type="text" name="baseline" placeholder="About three days to reply"></label>
          <label>Where it should be<input type="text" name="target" placeholder="One business day"></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Before we talk</legend>
        <label>What kind of information is involved
          <select name="data" required>
            <option value="">Choose</option>
            <option>No personal information</option>
            <option>Staff information only</option>
            <option>Student records</option>
            <option>Other sensitive information</option>
            <option>I am not sure</option>
          </select></label>
        <div class="hint" style="margin-top:6px">Please do not enter student names or ID numbers anywhere on this form.</div>
        <label>What is already in place, or already tried
          <div class="hint">Tools, workarounds, earlier attempts. For example: tutoring runs in Discord with limited hours, but students do not know it is there.</div>
          <textarea name="inplace"></textarea></label>
        <div class="grp">What kind of help, if you already know (optional)</div>
        <div class="checks">
          <label><input type="radio" name="kind" value="Not sure" checked> Not sure. Tell me what would fit</label>
          <label><input type="radio" name="kind" value="Tool"> An AI tool that people use</label>
          <label><input type="radio" name="kind" value="Agentic workflow"> An agentic workflow: steps that run on their own and hand off to a person</label>
          <label><input type="radio" name="kind" value="Training"> Training for my department</label>
          <label><input type="radio" name="kind" value="Process review"> A look at our process</label>
        </div>
      </fieldset>
      <div class="hp" aria-hidden="true"><label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
      <button class="btn" type="submit">Submit</button>
      <span id="fmsg" role="status" aria-live="polite"></span>
    </form>
  </section>

  <footer>
    AI Opportunity Pipeline &middot; Student Support and Success domain, Maricopa AI Resource Center.
    Please do not enter student names or ID numbers.
  </footer>
</div>

<script>
/* ─────────── data ─────────── */
const COLLEGES=["Chandler-Gilbert","Estrella Mountain","GateWay","Glendale","Mesa",
  "Paradise Valley","Phoenix","Rio Salado","Scottsdale","South Mountain"];

/* ─────────── init ─────────── */
COLLEGES.forEach(c=>{
    document.querySelector('[name=college]').insertAdjacentHTML('beforeend',`<option>${c}</option>`);
});



/* Set to the Apps Script web app URL (the /exec address). */
const AIP_ENDPOINT='https://script.google.com/macros/s/AKfycbzTkxtKDnaoqpfMalMdkHP2O_Ah8qsEtD8yym9Odk9zhRw_0lfGOVdAr6u2OTxYr8FM/exec';
document.getElementById('intake').addEventListener('submit',async e=>{
  e.preventDefault();
  const form=e.target,msg=document.getElementById('fmsg'),btn=form.querySelector('button[type=submit]');
  if(!form.checkValidity()){form.reportValidity();return;}
  if(!AIP_ENDPOINT){msg.className='bad';msg.textContent='Submitting is not connected yet.';return;}
  btn.disabled=true;msg.className='';msg.textContent='Sending';
  try{
    const res=await fetch(AIP_ENDPOINT,{method:'POST',body:new URLSearchParams(new FormData(form))});
    const out=await res.json();
    if(!out.ok) throw new Error(out.error||'failed');
    form.reset();msg.className='ok';
    msg.textContent='Received as '+out.id+'. We will reply at the email you gave.';
  }catch(err){
    msg.className='bad';msg.textContent='That did not send. Please try again in a few minutes.';
  }
  btn.disabled=false;
});

const tb=document.getElementById('themebtn');
tb.addEventListener('click',()=>{
  const dark=document.documentElement.getAttribute('data-theme')==='dark';
  document.documentElement.setAttribute('data-theme',dark?'light':'dark');
  tb.textContent=dark?'Dark':'Light';
});

</script>
</body>
</html>
