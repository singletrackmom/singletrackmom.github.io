        </div>
      </details>

      <details class="card local">
        <summary class="cardtop">
          <span class="srow"><span class="tag rank">#6</span><span class="stars" aria-label="Four out of five stars">&#9733;&#9733;&#9733;&#9733;&#9734;</span><span class="tag tag-new">New 27 Sept</span><span class="tag tag-new">Apply now</span></span>
