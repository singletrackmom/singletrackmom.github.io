      </details>

      <details class="card local">
        <summary class="cardtop">
          <span class="srow"><span class="tag rank">#7</span><span class="stars" aria-label="Four out of five stars">&#9733;&#9733;&#9733;&#9733;&#9734;</span><span class="tag tag-new">NEW 25 Sept</span></span>
          <h3 class="jt">Talent Development &amp; People Programs Manager, Learning Experience &amp; Onboarding</h3>
