<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Job matches</title>
  <style>
    :root{
      --paper:#f4f1ea; --card:#ffffff; --ink:#1f2421; --muted:#5c665f;
      --local:#1b5e57; --remote:#2d3e6e; --dream:#7a5080; --gold:#c8892a; --line:#e3ddd0;
    }
    *{box-sizing:border-box;}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;line-height:1.5;}
    .skip{position:absolute;left:-9999px;top:0;background:var(--ink);color:#fff;padding:10px 16px;border-radius:0 0 8px 0;z-index:10;text-decoration:none;font-size:14px;}
    .skip:focus{left:0;}
    header{padding:28px 20px 8px;max-width:960px;margin:0 auto;}
    h1{margin:0;font-size:26px;letter-spacing:-.01em;}
    .subtitle{color:var(--muted);font-size:14px;margin-top:4px;}
    .note{max-width:960px;margin:10px auto 0;padding:0 20px;color:var(--muted);font-size:12.5px;line-height:1.5;}
    main{max-width:960px;margin:0 auto;padding:8px 16px 60px;}
    .group{margin-top:26px;}
    .ghead{font-size:14px;text-transform:uppercase;letter-spacing:.06em;padding:8px 12px;border-radius:8px;color:#fff;display:flex;align-items:center;gap:10px;}
    .group.local .ghead{background:var(--local);}
    .group.remote .ghead{background:var(--remote);}
    .group.dream .ghead{background:var(--dream);}
    .gsub{font-weight:400;text-transform:none;letter-spacing:0;font-size:12px;opacity:.9;}
    .gcount{margin-left:auto;background:rgba(255,255,255,.22);border-radius:20px;padding:1px 10px;font-size:12px;}
    .card{background:var(--card);border:1px solid var(--line);border-left:5px solid var(--line);border-radius:10px;padding:14px 16px;margin-top:12px;}
    .card.local{border-left-color:var(--local);}
    .card.remote{border-left-color:var(--remote);}
    .card.dream{border-left-color:var(--dream);}
    .cardtop{display:flex;justify-content:space-between;align-items:center;gap:10px;}
    .stars{color:#8a5e18;font-size:14px;letter-spacing:1px;white-space:nowrap;}
    h3{margin:8px 0 2px;font-size:17px;}
    .co{font-weight:600;color:var(--ink);font-size:14px;}
    .meta{color:var(--muted);font-size:13px;margin-top:2px;}
    .why{font-size:14px;margin:10px 0 12px;}
    .why + .why{margin-top:-4px;}
    .card ul{margin:10px 0 12px;padding-left:20px;}
    .card li{font-size:14px;margin:0 0 5px;}
    .card li::marker{color:var(--muted);}
    .foot{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;}
    .tool{font-size:12px;color:var(--muted);}
    .apply{background:var(--ink);color:#fff;text-decoration:none;font-size:13px;font-weight:600;padding:7px 14px;border-radius:7px;}
    .tag{font-size:11px;font-weight:600;padding:2px 9px;border-radius:20px;}
    .tag-new{background:#e7f1ef;color:var(--local);}
    .tag-reach{background:#f4ece0;color:#7a5218;}
    .tag-co{background:#e7f1ef;color:#12433e;}
    .tag-ver{background:#eef0f6;color:var(--remote);}
    a.apply:hover{opacity:.88;}
    a.apply:focus-visible{outline:3px solid var(--gold);outline-offset:2px;}
    a:focus-visible{outline:3px solid var(--gold);outline-offset:2px;}
    summary:focus-visible{outline:3px solid var(--gold);outline-offset:2px;}
    details.log{margin-top:26px;border-top:1px solid var(--line);padding-top:14px;}
    .log>summary{font-size:13px;color:var(--muted);cursor:pointer;}
    .log .card{border-left-color:var(--line);}
    .log .card h3{font-size:15px;}

    /* collapsed job cards */
    details.card{padding:0;margin-top:10px;}
    summary.cardtop{display:block;padding:12px 34px 12px 14px;cursor:pointer;position:relative;list-style:none;}
    summary.cardtop::-webkit-details-marker{display:none;}
    summary.cardtop::after{content:"";position:absolute;right:15px;top:17px;width:9px;height:9px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(45deg);}
    details.card[open]>summary.cardtop::after{transform:rotate(-135deg);top:21px;}
    .srow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    summary.cardtop .stars{font-size:18px;letter-spacing:2px;}
    .jt{display:block;margin-bottom:0;font-size:16px;font-weight:700;line-height:1.3;margin-top:5px;}
    .sub{display:block;font-size:13px;color:var(--muted);margin-top:3px;}
    .sub b{color:var(--ink);font-weight:600;}
    .body{padding:12px 14px 12px;border-top:1px solid var(--line);}
    .body ul{margin:0 0 10px;padding-left:19px;}
    .body .why{margin:0 0 8px;}
    .body .foot{margin-top:10px;}
  .tag.rank{background:#7a5080;color:#fff;font-weight:700;letter-spacing:.02em}
</style>
</head>
