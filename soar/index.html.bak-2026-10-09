<script>
/* Internship save/hide. Vanilla, no dependencies, degrades to a plain list if JS is off.
   Added 31 Aug 2026 at Michelle’s request so Jasper can triage the list himself. */
(function(){
  var KEY='soar-jobs-v1';
  var jobs=[].slice.call(document.querySelectorAll('.job[data-job]'));
  if(!jobs.length){return;}
  var state={};
  try{ state=JSON.parse(localStorage.getItem(KEY)||'{}')||{}; }catch(e){ state={}; }
  function save(){ try{ localStorage.setItem(KEY,JSON.stringify(state)); }catch(e){} }
  var counts=document.getElementById('jb-counts');
  var box=document.getElementById('jb-box');
  var out=document.getElementById('jb-out');
  function paint(){
    var s=0,h=0;
    jobs.forEach(function(j){
      var id=j.getAttribute('data-job'), v=state[id]||'';
      j.setAttribute('data-state',v);
      if(v==='saved'){s++;} if(v==='hidden'){h++;}
      j.querySelectorAll('[data-act]').forEach(function(b){
        b.setAttribute('aria-pressed', String(b.getAttribute('data-act')===v));
        var a=b.getAttribute('data-act');
        b.textContent = (a===v) ? (a==='saved'?'Saved':'Hidden') : (a==='save'?'Save':'Hide');
      });
    });
    if(counts){
      counts.textContent = (s||h)
        ? (s+' saved, '+h+' hidden, '+(jobs.length-h)+' showing.')
        : 'Save or hide as you read.';
    }
  }
  jobs.forEach(function(j){
    j.querySelectorAll('[data-act]').forEach(function(b){
      b.addEventListener('click',function(){
        var id=j.getAttribute('data-job');
        var want=b.getAttribute('data-act')==='save'?'saved':'hidden';
        state[id] = (state[id]===want) ? '' : want;
        save(); paint();
      });
    });
  });
  var t=document.getElementById('jb-toggle');
  if(t){ t.addEventListener('click',function(){
    var on=document.body.classList.toggle('show-hidden');
    t.setAttribute('aria-pressed',String(on));
    t.textContent = on ? 'Hide hidden' : 'Show hidden';
  }); }
  var r=document.getElementById('jb-reset');
  if(r){ r.addEventListener('click',function(){ state={}; save(); paint(); if(box){box.hidden=true;} }); }
  var l=document.getElementById('jb-list');
  if(l){ l.addEventListener('click',function(){
    var saved=[],hidden=[];
    jobs.forEach(function(j){
      var id=j.getAttribute('data-job');
      var t=j.querySelector('.job-m');
      var label=(t?t.textContent.trim():id)+' ['+id+']';
      if(state[id]==='saved'){saved.push(label);}
      if(state[id]==='hidden'){hidden.push(label);}
    });
    var d=new Date().toISOString().slice(0,10);
    var txt='SOAR INTERNSHIP PICKS '+d+'\n\nKEEP:\n'+(saved.length?saved.map(function(x){return '- '+x;}).join('\n'):'- (none picked yet)')+'\n\nDROP:\n'+(hidden.length?hidden.map(function(x){return '- '+x;}).join('\n'):'- (none)');
    if(out){ out.value=txt; }
    if(box){ box.hidden=false; }
    if(out){ out.focus(); out.select(); }
  }); }
  paint();
})();
</script>

<script>
/* Jump menu: open the target section and land it clear of the sticky nav. 31 Aug 2026. */
(function(){
  function openTarget(){
    var id=location.hash.replace('#','');
    if(!id){return;}
    var el=document.getElementById(id);
    if(el&&el.tagName==='DETAILS'&&!el.open){ el.open=true; }
    if(el){ setTimeout(function(){ el.scrollIntoView({block:'start'}); },0); }
  }
  document.querySelectorAll('.toc a').forEach(function(a){
    a.addEventListener('click',function(){ setTimeout(openTarget,0); });
  });
  window.addEventListener('hashchange',openTarget);
  if(location.hash){ openTarget(); }
})();
</script>
